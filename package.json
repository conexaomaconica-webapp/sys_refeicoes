{
  "name": "sys-marefeicoes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node -r ./scripts/patch-fs.cjs ./node_modules/next/dist/bin/next dev",
    "dev:turbo": "node -r ./scripts/patch-fs.cjs ./node_modules/next/dist/bin/next dev --turbopack",
    "build": "node -r ./scripts/patch-fs.cjs ./node_modules/next/dist/bin/next build",
    "start": "node -r ./scripts/patch-fs.cjs ./node_modules/next/dist/bin/next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "validate:sprint4": "node scripts/validate-sprint4.cjs",
    "validate:sprint11": "node scripts/validate-sprint11.cjs",
    "validate:sprint12": "node scripts/validate-sprint12.cjs",
    "validate:sprint13": "node scripts/validate-sprint13-contingency.cjs",
    "validate:login-branding": "node scripts/validate-login-branding.cjs",
    "validate:consumer-branding": "node scripts/validate-consumer-card-branding.cjs",
    "validate:consumer-access": "node scripts/validate-consumer-access-management.cjs",
    "validate:first-access": "node scripts/validate-consumer-first-access.cjs",
    "validate:admin-temporary-password": "node scripts/validate-admin-temporary-password.cjs",
    "validate:stabilization": "node scripts/validate-post-sprint10-stabilization.cjs",
    "validate:stage6": "node scripts/validate-stage6.cjs",
    "validate:stage7": "node scripts/validate-stage7-security.cjs",
    "validate:stage7c-prep": "node scripts/validate-stage7c-preparation.cjs",
    "validate:stage7c-native": "node scripts/validate-stage7c-native.cjs",
    "validate:stage7d-local": "node scripts/validate-stage7d-local.cjs",
    "validate:stage7d-performance": "node scripts/validate-stage7d-performance.cjs",
    "validate:stage7d4-readiness": "node scripts/validate-stage7d-staging-readiness.cjs",
    "validate:stage8a-readonly": "node scripts/validate-stage8a-readonly.cjs",
    "validate:stage8a-credential": "node scripts/validate-stage8a-credential-preparation.cjs",
    "validate:stage8a-hardening": "node scripts/validate-stage8a-function-hardening.cjs",
    "validate:stage8a-transactional": "node scripts/validate-stage8a-transactional.cjs",
    "validate:stage8a-readiness": "node scripts/validate-stage8a-readiness.cjs",
    "validate:stage9-planning": "node scripts/validate-stage9-planning.cjs",
    "validate:stage9c": "node scripts/validate-stage9c.cjs",
    "validate:stage9d": "node scripts/stage9d/run-local-homologation.cjs",
    "validate:stage9d1": "node scripts/validate-stage9d1.cjs",
    "verify:stage9d1-build": "node scripts/stage9d1/verify-build-artifact.cjs",
    "smoke:stage9d1": "node scripts/stage9d1/smoke-local-build.cjs",
    "validate:stage9e-prep": "node scripts/validate-stage9e-preparation.cjs && node scripts/stage9e/validate-evidence.cjs",
    "validate:stage9e1-preflight": "node scripts/stage9e/validate-9e1-preflight.cjs",
    "inventory:stage9e1:sql": "node scripts/stage9e/inventory-recovery-sql-readonly.cjs",
    "inventory:stage9e1:backups": "node scripts/stage9e/inventory-recovery-backups-readonly.cjs",
    "backup:stage9e1b": "node scripts/stage9e/create-stage9e1b-backup.cjs",
    "backup:stage9e1b:finalize": "node scripts/stage9e/finalize-stage9e1b-backup.cjs",
    "validate:stage9e1b": "node scripts/stage9e/validate-stage9e1b.cjs",
    "validate:stage9e1a": "node scripts/stage9e/validate-9e1a-inventory.cjs",
    "preflight:stage9e2": "node scripts/stage9e/preflight-payment-sandbox.cjs",
    "validate:stage9e2-master": "node scripts/validate-stage9e2-master-integration.cjs",
    "audit:stage8a:readonly": "node scripts/audit-stage8a-readonly.cjs",
    "snapshot:stage8a:migration75": "node scripts/stage8a/run-migration75-snapshot.cjs",
    "homologate:stage7c": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage7c/run-disposable.ps1",
    "homologate:stage7c:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage7c/run-native-disposable.ps1",
    "homologate:stage7d:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage7d/run-native-performance.ps1",
    "homologate:stage8a:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage8a/run-native-hardening.ps1",
    "pipeline:check": "pnpm run lint && pnpm run typecheck && pnpm run validate:sprint4 && pnpm run validate:sprint11 && pnpm run validate:sprint12 && pnpm run validate:login-branding && pnpm run validate:consumer-branding && pnpm run validate:consumer-access && pnpm run validate:first-access && pnpm run validate:stabilization && pnpm run build",
    "ci:check": "pnpm run pipeline:check && pnpm run validate:stage6 && pnpm run validate:stage7 && pnpm run validate:stage7c-prep && pnpm run validate:stage7c-native && pnpm run validate:stage7d-local && pnpm run validate:stage7d-performance && pnpm run validate:stage7d4-readiness && pnpm run validate:stage8a-credential && pnpm run validate:stage8a-hardening && pnpm run validate:stage8a-readiness && pnpm run validate:stage9-planning && pnpm run validate:stage9c",
    "release:check-env-example": "node scripts/release/check-environment.cjs --example",
    "release:verify": "node scripts/release/verify-deployment.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.57.0",
    "next": "15.5.28",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@next/eslint-plugin-next": "15.5.28",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "pg": "8.23.1",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
