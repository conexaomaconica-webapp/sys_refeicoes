# ==============================================================================
# SISTEMA DE CONTROLE DE REFEIÇÕES — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# SUPABASE (PÚBLICAS - ACESSÍVEIS NO FRONTEND E BACKEND)
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# SUPABASE (PRIVADAS - EXCLUSIVAS DO SERVIDOR / BACKEND)
# ATENÇÃO: NUNCA ADICIONE O PREFIXO "NEXT_PUBLIC_" NESTA CHAVE!
# O USO INDEVIDO NO FRONTEND EXPORIA PRIVILÉGIOS TOTAIS AO CLIENTE.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada-aqui

# HMAC privado e estável (mínimo 32 caracteres) para proteger CPF e rate limit.
# Gere um valor aleatório exclusivo por ambiente e nunca use prefixo NEXT_PUBLIC_.
CONSUMER_IDENTITY_HMAC_KEY=gere-uma-chave-aleatoria-com-no-minimo-32-caracteres

# PAGAMENTOS (OPCIONAIS; EXCLUSIVOS DO SERVIDOR)
DEFAULT_PAYMENT_PROVIDER=mock
ASAAS_API_KEY=configure-somente-se-o-asaas-for-homologado
ASAAS_WEBHOOK_SECRET=configure-somente-se-o-asaas-for-homologado
# Selecao explicita: true usa https://api-sandbox.asaas.com/v3; false usa producao.
ASAAS_SANDBOX=true
MERCADOPAGO_ACCESS_TOKEN=configure-somente-se-o-mercado-pago-for-homologado
MERCADOPAGO_WEBHOOK_SECRET=configure-somente-se-o-mercado-pago-for-homologado
# Confirmacao operacional; a API usa o mesmo host e a credencial deve vir da aba Teste.
MERCADOPAGO_SANDBOX=true

# CREDENCIAIS DE TESTE LOCAIS (NUNCA versionar valores reais)
CAIXA_TEST_PASSWORD=defina-uma-senha-local-segura
OPERATOR_TEST_PASSWORD=defina-outra-senha-local-segura
OPERATOR_PREVIOUS_PASSWORD=defina-a-senha-anterior-apenas-para-rotacao-local

# CONFIGURAÇÕES DA APLICAÇÃO
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Sistema de Refeições"
# Slug público do tenant exibido antes da autenticação (login e splash).
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=seu-tenant

# AMBIENTE (development | staging | production)
NODE_ENV=development
