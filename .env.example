# ==============================================================================
# SISTEMA DE CONTROLE DE REFEIÇÕES — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# SUPABASE (PÚBLICAS - ACESSÍVEIS NO FRONTEND E BACKEND)
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# SUPABASE (PRIVADAS - EXCLUSIVAS DO SERVIDOR / BACKEND)
# ATENÇÃO: NUNCA ADICIONE O PREFIXO "NEXT_PUBLIC_" NESTA CHAVE!
# O USO INDEVIDO NO FRONTEND EXPORIA PRIVILÉGIOS TOTAIS AO CLIENTE.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada-aqui

# CONFIGURAÇÕES DA APLICAÇÃO
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Sistema de Refeições"

# AMBIENTE (development | staging | production)
NODE_ENV=development
